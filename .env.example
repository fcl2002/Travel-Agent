# Local development credentials used by Docker Compose.
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=travel_agent_dev
POSTGRES_DB=travel_agent
POSTGRES_PORT=5433

# Used when running Python directly on your machine.
# Docker Compose sets its own URL using the database service hostname, db.
DATABASE_URL=postgresql+psycopg://travel_agent:travel_agent_dev@localhost:5433/travel_agent
LOG_LEVEL=INFO

# Generate with secrets.token_urlsafe(32); see README. Never commit a real key.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=travel-agent
JWT_AUDIENCE=travel-agent-api
REFRESH_TOKEN_EXPIRE_DAYS=7
# Local HTTP development only. Production must set this to true and use HTTPS.
REFRESH_COOKIE_SECURE=false
# Optional exact browser origin, e.g. http://localhost:3000 (same-site frontend).
# FRONTEND_ORIGIN=
# Exact IP or CIDR of the gateway in front of the API, e.g. 10.0.0.5. Never use *.
# FORWARDED_ALLOW_IPS=
