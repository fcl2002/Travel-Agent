# Local development credentials used by Docker Compose.
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=travel_agent_dev
POSTGRES_DB=travel_agent
POSTGRES_PORT=5433

# Used when running Python directly on your machine.
# Docker Compose sets its own URL using the database service hostname, db.
DATABASE_URL=postgresql+psycopg://travel_agent:travel_agent_dev@localhost:5433/travel_agent
